# OmniFlow AI Environment Configuration

# Server configuration
OMNIFLOW_HOST=127.0.0.1
OMNIFLOW_PORT=8000
OMNIFLOW_API_BASE_URL=http://127.0.0.1:8000

# Database
OMNIFLOW_DATABASE_URL=sqlite:///./omniflow.db

# LLM Configuration (Google Gemini)
# Leave empty to run in deterministic offline/demo mode with full disclosure
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Execution & Browser
PLAYWRIGHT_HEADLESS=true
BROWSER_TIMEOUT_MS=15000
MAX_STEP_RETRIES=2
MAX_SOURCES_PER_QUERY=3

# Demo & Recovery Simulation Settings
# Enable DEMO_MODE to execute using bundled offline fixtures when offline
DEMO_MODE=false
# Enable SIMULATE_CONTROLLED_FAILURE to showcase autonomous error recovery in Step 3
SIMULATE_CONTROLLED_FAILURE=false
